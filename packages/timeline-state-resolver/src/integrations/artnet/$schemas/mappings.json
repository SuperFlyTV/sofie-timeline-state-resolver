{
	"$schema": "../../../$schemas/mapping-schema.json",
	"default": "mappings",
	"mappings": {


		"channels": {
			"type": "object",
			"properties": {
				
				"universe": {
					"type": "number"
				},
				"featureChannels": {
					"type": "object",
					"properties": {},
					"description": "Maps channel numbers to Features. Values are either a channel (number), multiple channels (number[]), or range of channels eg '1-512'.",
					"patternProperties": {
						".*": {
							
							"oneOf": [
								{
									"type": "number"
								},
								{
									"type": "array",
									"items": {
										"type": "number"
									}
								},
								{
									"type": "string",
									"pattern": "\\d+-\\d+"
								}
		
							]
		
						}
					},
					"additionalProperties": false
				}
			},
			"required": ["universe", "featureChannels"],
			"additionalProperties": false
		}




		
	}
}
